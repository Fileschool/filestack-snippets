# Your Filestack API key. Safe to expose in the browser: it identifies the application,
# it is not a secret. Get one at https://dev.filestack.com/signup/free
VITE_FILESTACK_API_KEY=YOUR_API_KEY

# App secret, used only by server/policy-server.mjs to sign policies.
# This one IS a secret. Never import it into client code.
FILESTACK_APP_SECRET=YOUR_APP_SECRET
